{
  "uid": "ai-gateway",
  "title": "AI Gateway",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(gateway_requests_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(gateway_requests_total{status=\"failed\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Fallback",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(gateway_fallback_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Unknown usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(gateway_unknown_usage_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Request p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum(rate(gateway_request_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "TTFT p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum(rate(gateway_ttft_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Tokens",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(gateway_tokens_total[5m])) by (direction)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Unsettled attempts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "gateway_unsettled_attempts",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Audit queue bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(gateway_audit_queue_bytes)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Settlement failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(gateway_settlement_failures_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Audit failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(gateway_audit_failures_total) by (stage)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Incomplete audits",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "gateway_audit_incomplete_requests",
          "refId": "A"
        }
      ]
    }
  ]
}
